# Sao chép thành .env (không commit).
SITE_NAME=
SITE_URL=https://localhost
CADDY_SITE=localhost
POSTGRES_USER=clp
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=clp
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
ADMIN_EMAILS=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
TTS_DAILY_LIMIT=500
AUDIO_SLOW_MODE=rate
REPO_URL=
WHISPER_MODEL=base

# Soạn nội dung bằng AI (pipeline, chỉ chạy tay trên máy dev): dùng Claude Code CLI đã đăng nhập
# trên máy host (dịch vụ py-claude), không cần API key. Đặt khi CLI hoặc đăng nhập ở chỗ khác:
# CLP_CLAUDE_HOST_BIN=/đường/dẫn/claude
# CLP_CLAUDE_HOST_CREDENTIALS=/đường/dẫn/.credentials.json
# CLP_AUTHOR_MODEL=claude-opus-5-5
# CLP_REVIEW_MODEL=claude-sonnet-5-5
# CLP_AUTHOR_EFFORT=high
